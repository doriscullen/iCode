ImportMcpServersDialog {
    align: center middle;
}

/* Sized like the agent config window it opens over, a little smaller so that window still frames it. */
#mcp-import-container {
    width: 90%;
    min-width: 60;
    max-width: 110;
    height: 80%;
    max-height: 56;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
    padding: 0;
}

#mcp-import-body {
    height: 1fr;
}

/* Left sidebar, as in the agent config window */
#mcp-import-sidebar {
    width: 20;
    height: 1fr;
    border-right: solid $tui-border-foreground 15%;
}

#mcp-import-sources {
    height: 1fr;
    border: none;
    padding: 0 0 0 1;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
}

/* Hover renders cache their separator too; keep its background stable across focus changes. */
#mcp-import-sources:focus {
    background-tint: transparent;
}

/* Right panel: the servers, with the buttons that act on them below */
#mcp-import-right {
    width: 1fr;
    height: 1fr;
}

#mcp-import-servers {
    height: 1fr;
    padding: 1 1 0 2;
    scrollbar-size-vertical: 1;
}

#mcp-import-buttons {
    align: right top;
}

#mcp-import-servers .mcp-import-item {
    height: auto;
    align-horizontal: left;
}

#mcp-import-servers .mcp-import-card {
    width: 1fr;
    padding: 0 1 1 1;
    margin: 0 1 1 0;
}

/* Folded to its header, the card keeps no blank line under it. */
#mcp-import-servers .mcp-import-card.-collapsed {
    padding: 0 1;
}

/* The tick, outside the card: it sits level with the title line inside the card's top border. */
#mcp-import-servers .mcp-import-row {
    width: 3;
    height: 1;
    margin: 1 1 0 0;
    border: none;
    background: transparent;
    background-tint: transparent;
    padding: 0;
}

#mcp-import-servers .mcp-import-row:focus {
    background: $foreground 8%;
}

#mcp-import-servers .mcp-import-row > .toggle--button {
    color: $foreground 35%;
    background: transparent;
}

#mcp-import-servers .mcp-import-row.-on > .toggle--button {
    color: $success;
    background: transparent;
}

/* The title line: the fold's target, and the name and summary the server is known by. */
#mcp-import-servers .mcp-import-title {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $secondary;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: clip;
}

#mcp-import-servers .mcp-import-title:hover {
    background: $block-hover-background;
    color: $foreground;
}

#mcp-import-servers .mcp-import-title:focus {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: $block-cursor-text-style;
}

/* The connection summary follows the title's hover and focus colours. */
#mcp-import-servers .mcp-import-title > .cardtitle--summary {
    color: $text-muted;
    text-style: not bold;
}

#mcp-import-servers .mcp-import-title:hover > .cardtitle--summary {
    color: $foreground;
}

#mcp-import-servers .mcp-import-title:focus > .cardtitle--summary {
    color: $block-cursor-foreground;
}

/* Detailed refusal or duplicate reason, visible only when unfolded. */
#mcp-import-servers .mcp-import-hint {
    height: auto;
    margin-top: 1;
    color: $foreground;
    text-wrap: wrap;
}

/* A card that can't be ticked: dashed and bare, its settings faded; the reason it can't be stays readable. */
#mcp-import-servers .mcp-import-card.-unavailable {
    border: dashed $tui-border-foreground 30%;
    background: transparent;
}

#mcp-import-servers .mcp-import-card.-unavailable .mcp-import-field-label,
#mcp-import-servers .mcp-import-card.-unavailable .mcp-import-field-value,
#mcp-import-servers .mcp-import-card.-unavailable .mcp-import-pair-key,
#mcp-import-servers .mcp-import-card.-unavailable .mcp-import-pair-value {
    text-opacity: 50%;
}

/* One titled box per group, titled as the agent's MCP card titles them. */
#mcp-import-servers .mcp-import-section {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 2 1 2;
    border: solid $tui-border-foreground 15%;
    border-title-color: $text-muted;
}

#mcp-import-servers .mcp-import-field-label {
    height: 1;
    color: $text-muted;
    margin: 1 0 0 0;
}

/* Values look like the config card's read-only inputs they become once imported. */
#mcp-import-servers .mcp-import-field-value {
    height: auto;
    background: $foreground 8%;
    padding: 0 1;
}

#mcp-import-servers .mcp-import-field-value > .mcp-import-value--annotation {
    color: $text-muted;
}

/* One line, cut at the edge, as in the card's one-line inputs (URL, env vars, headers). */
#mcp-import-servers .mcp-import-field-value.-single-line,
#mcp-import-servers .mcp-import-pair-key,
#mcp-import-servers .mcp-import-pair-value {
    height: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

/* Env vars and headers: names and values in two equal columns, rows apart, as on the agent's MCP card. */
#mcp-import-servers .mcp-import-pairs {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 1 1;
    height: auto;
}

#mcp-import-servers .mcp-import-pair-key,
#mcp-import-servers .mcp-import-pair-value {
    color: $foreground;
    background: $foreground 8%;
    padding: 0 1;
}

#mcp-import-servers .mcp-import-warning {
    height: auto;
    margin: 1 0 0 0;
}

#mcp-import-servers .mcp-import-warning {
    color: $foreground;
}

#mcp-import-servers .mcp-import-status {
    dock: right;
    width: auto;
    height: 1;
    padding-left: 2;
    color: $text-muted;
    text-style: not bold;
    text-wrap: nowrap;
}

#mcp-import-servers .mcp-import-title.-attention .mcp-import-status {
    color: $warning;
}

#mcp-import-servers .mcp-import-title:hover .mcp-import-status {
    color: $foreground;
}

#mcp-import-servers .mcp-import-title:focus .mcp-import-status {
    color: $block-cursor-foreground;
}

#mcp-import-servers .mcp-import-notes {
    height: auto;
    background: $foreground 4%;
    padding: 0 1 1 1;
    margin: 1 0;
}

#mcp-import-servers .mcp-import-notes.-attention {
    background: $warning 6%;
}

#mcp-import-servers .mcp-import-notes.-error {
    background: $error 6%;
}

#mcp-import-servers .mcp-import-notes-title {
    height: auto;
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

#mcp-import-servers .mcp-import-notes.-attention .mcp-import-notes-title {
    color: $warning;
}

#mcp-import-servers .mcp-import-notes.-error .mcp-import-notes-title {
    color: $error;
}

#mcp-import-servers .mcp-import-warning-group {
    height: auto;
}

#mcp-import-servers .mcp-import-error {
    height: auto;
    color: $error;
    margin: 0 1 1 0;
}

#mcp-import-servers .mcp-import-message {
    height: auto;
    color: $text-muted;
}

/* No servers: the hatched box of the agent's MCP tab, ending where the cards end. */
#mcp-import-servers .mcp-import-empty {
    margin: 0 1 1 0;
}
